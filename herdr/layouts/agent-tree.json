{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "preview": "layouts/agent-tree.svg",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    12
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 256
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "agents",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 84,
          "content": {
            "mod": "agent-tree"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 56
          },
          "content": {
            "mod": "sidebar-footer"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 36
          },
          "window_drag": true,
          "content": {
            "mod": "tab-bar"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 6,
          "gap": 6,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 6,
                  "radius": 8,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane-header"
                    },
                    "height": 26,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 348
              },
              "min": 260,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 24
          },
          "content": {
            "mod": "status-bar"
          }
        }
      ]
    }
  ]
}
