{
  "$schema": "https://opencode.ai/config.json",
  "modelScope": "~/src/personal",
  "permissions": {
    "allow": [
      "Bash(gh pr create --draft *)",
      "Read(/tmp/**)",
      "Bash(ls /tmp*)",
      "Bash(* /tmp/*)"
    ],
    "deny": [
      "Bash(gh pr review --approve *)",
      "Bash(gh pr review -a *)",
      "Bash(gh pr merge *)"
    ]
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
