#!/usr/bin/env bash
# agent-tmux: mirror coding-agent state onto the tmux window running the agent,
# then navigate to the windows that want you.
set -euo pipefail
exec python3 - "$@" <<'PY'
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

USAGE = """\
agent-tmux: mirror coding-agent state onto the tmux window running the agent,
then navigate to the windows that want you.

Usage:
  agent-tmux state <idle|busy|monitor|waiting|done|error|clear> [--soft]
  agent-tmux worktree <path>    # the checkout this agent moved to
  agent-tmux seen <window-id>   # a window you looked at is no longer "done"
  agent-tmux jump <pane-id>     # select the next window wanting attention
  agent-tmux menu <pane-id>     # picker over every agent window"""

GLYPHS = {
    "idle": ("○", "colour240"),
    "busy": ("◐", "colour75"),
    "monitor": ("◇", "colour44"),
    "waiting": ("◆", "colour214"),
    "done": ("●", "colour114"),
    "error": ("✖", "colour167"),
}
ATTENTION = {"waiting", "done", "error"}
CONVENTIONAL_PREFIXES = (
    "feat/",
    "fix/",
    "docs/",
    "refactor/",
    "perf/",
    "test/",
    "build/",
    "ci/",
    "chore/",
)
MENU_KEYS = "123456789abcdefgilmnoprstuvxyz"


def tmux(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["tmux", *args], text=True, capture_output=True, check=False)


def render(state: str) -> str | None:
    if state not in GLYPHS:
        return None
    glyph, color = GLYPHS[state]
    return f"#[fg={color},bold]{glyph}#[default]"


def repo_name(directory: str) -> str:
    res = subprocess.run(
        ["git", "-C", directory, "rev-parse", "--git-common-dir"],
        text=True,
        capture_output=True,
        check=False,
    )
    if res.returncode != 0 or not res.stdout.strip():
        return ""
    common = (Path(directory) / res.stdout.strip()).resolve()
    return common.parent.name


def window_label(directory: str) -> str | None:
    if (
        subprocess.run(
            ["git", "-C", directory, "rev-parse", "--git-dir"],
            capture_output=True,
            check=False,
        ).returncode
        != 0
    ):
        return None
    branch = subprocess.run(
        ["git", "-C", directory, "branch", "--show-current"],
        text=True,
        capture_output=True,
        check=False,
    ).stdout.strip()
    if not branch:
        branch = (
            subprocess.run(
                ["git", "-C", directory, "rev-parse", "--short", "HEAD"],
                text=True,
                capture_output=True,
                check=False,
            ).stdout.strip()
            or "detached"
        )
    for prefix in CONVENTIONAL_PREFIXES:
        if branch.startswith(prefix):
            branch = branch[len(prefix) :]
            break
    if len(branch) > 20:
        branch = branch[:19] + "…"
    return branch


def checkout(agent_dir: str, pane_path: str) -> str:
    return agent_dir if agent_dir and os.path.isdir(agent_dir) else pane_path


def refresh() -> None:
    clients = tmux("list-clients", "-F", "#{client_name}").stdout.splitlines()
    for client in clients:
        if client:
            tmux("refresh-client", "-S", "-t", client)


def elapsed(since: str) -> str:
    if not since.isdigit():
        return ""
    delta = max(0, int(time.time()) - int(since))
    if delta < 60:
        return f"{delta}s"
    if delta < 3600:
        return f"{delta // 60}m"
    return f"{delta // 3600}h{(delta % 3600) // 60}m"


def cmd_state(args: list[str]) -> int:
    if not args or not args[0]:
        print("state required", file=sys.stderr)
        return 2
    state = args[0]
    soft = args[1] if len(args) > 1 else ""
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return 0

    if soft == "--soft":
        cur = tmux("show", "-wqv", "-t", pane, "@agent_state").stdout.strip()
        if cur == "monitor":
            return 0

    if state == "clear":
        for opt in ("@agent_state", "@agent_status", "@agent_since", "@agent_dir"):
            tmux("set", "-uw", "-t", pane, opt)
        tmux("set", "-w", "-t", pane, "automatic-rename", "on")
        refresh()
        return 0

    status = render(state)
    if status is None:
        print(f"unknown state: {state}", file=sys.stderr)
        return 2

    tmux("set", "-w", "-t", pane, "@agent_state", state)
    tmux("set", "-w", "-t", pane, "@agent_status", status)
    tmux("set", "-w", "-t", pane, "@agent_since", str(int(time.time())))

    agent_dir = tmux("show", "-wqv", "-t", pane, "@agent_dir").stdout.strip()
    pane_path = tmux(
        "display-message", "-p", "-t", pane, "#{pane_current_path}"
    ).stdout.strip()
    label = window_label(checkout(agent_dir, pane_path))
    if label:
        tmux("set", "-w", "-t", pane, "automatic-rename", "off")
        tmux("rename-window", "-t", pane, label)
    refresh()
    return 0


def cmd_worktree(args: list[str]) -> int:
    if not args or not args[0]:
        print("worktree path required", file=sys.stderr)
        return 2
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return 0
    raw = args[0]
    if not os.path.isdir(raw):
        print(f"no such directory: {raw}", file=sys.stderr)
        return 2
    directory = os.path.abspath(raw)
    label = window_label(directory)
    if not label:
        print(f"not a git worktree: {directory}", file=sys.stderr)
        return 2

    tmux("set", "-w", "-t", pane, "@agent_dir", directory)
    tmux("set", "-w", "-t", pane, "automatic-rename", "off")
    tmux("rename-window", "-t", pane, label)
    refresh()
    return 0


def cmd_seen(args: list[str]) -> int:
    if not args or not args[0]:
        print("window id required", file=sys.stderr)
        return 2
    window = args[0]
    if tmux("show", "-wqv", "-t", window, "@agent_state").stdout.strip() != "done":
        return 0
    tmux("set", "-w", "-t", window, "@agent_state", "idle")
    tmux("set", "-w", "-t", window, "@agent_status", render("idle") or "")
    refresh()
    return 0


def cmd_jump(args: list[str]) -> int:
    if not args or not args[0]:
        print("pane id required", file=sys.stderr)
        return 2
    pane = args[0]
    session = tmux("display-message", "-p", "-t", pane, "#{session_name}").stdout.strip()
    cur_str = tmux("display-message", "-p", "-t", pane, "#{window_index}").stdout.strip()
    current = int(cur_str) if cur_str.isdigit() else 0

    windows: list[int] = []
    out = tmux("list-windows", "-t", session, "-F", "#{window_index} #{@agent_state}").stdout
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit() and parts[1] in ATTENTION:
            windows.append(int(parts[0]))

    if not windows:
        tmux("display-message", "-t", pane, "no agent is waiting on you")
        return 0

    target = next((idx for idx in windows if idx > current), windows[0])
    tmux("select-window", "-t", f"{session}:{target}")
    return 0


def cmd_menu(args: list[str]) -> int:
    if not args or not args[0]:
        print("pane id required", file=sys.stderr)
        return 2
    pane = args[0]
    session = tmux("display-message", "-p", "-t", pane, "#{session_name}").stdout.strip()
    fmt = "#{window_index}\t#{window_name}\t#{@agent_state}\t#{@agent_since}\t#{@agent_dir}\t#{pane_current_path}"
    lines = tmux("list-windows", "-t", session, "-F", fmt).stdout.splitlines()

    items: list[str] = []
    key_idx = 0
    for line in lines:
        parts = line.split("\t")
        if len(parts) < 6:
            continue
        index, name, state, since, agent_dir, pane_path = parts[:6]
        status = render(state)
        if not status:
            continue
        directory = checkout(agent_dir, pane_path)
        age = elapsed(since)
        repo = repo_name(directory)
        repo_prefix = f"{repo}/" if repo else ""
        age_suffix = f"  {age}" if age else ""
        key = MENU_KEYS[key_idx] if key_idx < len(MENU_KEYS) else ""
        items.extend(
            [
                f"{status} {index}:{repo_prefix}{name}{age_suffix}",
                key,
                f"select-window -t {session}:{index}",
            ]
        )
        key_idx += 1

    if not items:
        tmux("display-message", "-t", pane, "no agent windows")
        return 0

    tmux("display-menu", "-t", pane, "-x", "C", "-y", "C", "-T", " agents ", *items)
    return 0


def main() -> int:
    if not shutil.which("tmux"):
        return 0
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    sub, rest = argv[0], argv[1:]
    dispatch = {
        "state": cmd_state,
        "worktree": cmd_worktree,
        "seen": cmd_seen,
        "jump": cmd_jump,
        "menu": cmd_menu,
    }
    if sub not in dispatch:
        print(f"error: unknown subcommand: {sub}", file=sys.stderr)
        return 2
    return dispatch[sub](rest)


if __name__ == "__main__":
    raise SystemExit(main())
PY
