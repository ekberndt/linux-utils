#!/usr/bin/env python3
"""Claude Code and Antigravity CLI status line.

Reads the session JSON payload on stdin and renders:
  repo, branch, local path, open PR, changed files, model/effort/fast,
  session title, context used, session tokens in/out, window size, 5h budget.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

ELLIPSIS = "\u2026"
BULLET = "\u00b7"
ICON_REPO = "\uf401"
ICON_BRANCH = "\ue0a0"
ICON_PR = "\uf407"
ICON_DIFF = "\uf459"
ICON_DIR = "\uf07b"
ICON_MODEL = "\uf2db"
ICON_TITLE = "\uf02b"
ICON_USED = "\uf0e4"
ICON_IN = "\uf063"
ICON_OUT = "\uf062"
ICON_WINDOW = "\uf2d0"
ICON_CLOCK = "\uf017"

RESET = "\033[0m"
DIM = "\033[2m"
MAGENTA = "\033[38;5;170m"
GREEN = "\033[38;5;114m"
BLUE = "\033[38;5;75m"
CYAN = "\033[38;5;80m"
YELLOW = "\033[38;5;180m"
RED = "\033[38;5;167m"


def clean(val: object) -> str:
    if val is None:
        return ""
    return re.sub(r"\s+", " ", str(val)).strip()


def clamp(text: str, width: int) -> str:
    return f"{text[: width - 1]}{ELLIPSIS}" if len(text) > width else text


def human(n: int) -> str:
    if n <= 0:
        return ""
    if n < 1000:
        return str(n)
    unit, div = ("K", 1_000) if n < 1_000_000 else ("M", 1_000_000)
    whole = n // div
    if whole < 100:
        return f"{whole}.{(n % div) * 10 // div}{unit}"
    return f"{whole}{unit}"


def label(n: int, suffix: str) -> str:
    val = human(n)
    return f"{val} {suffix}" if val else ""


def git_out(cwd: str, *args: str) -> str:
    try:
        res = subprocess.run(
            ["git", "--no-optional-locks", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=2,
        )
        return res.stdout.strip() if res.returncode == 0 else ""
    except OSError:
        return ""


def read_transcript_tokens(path_str: str) -> tuple[int, int]:
    if not path_str:
        return 0, 0
    path = Path(path_str)
    if not path.is_file():
        return 0, 0
    by_msg: dict[str, dict] = {}
    try:
        for line in path.read_text(errors="replace").splitlines():
            if not line.strip():
                continue
            row = json.loads(line)
            msg = row.get("message") if isinstance(row, dict) else None
            usage = msg.get("usage") if isinstance(msg, dict) else None
            if isinstance(usage, dict):
                key = str(msg.get("id") or row.get("requestId") or "?")
                by_msg[key] = usage
    except (OSError, json.JSONDecodeError):
        return 0, 0

    tokens_in = sum(
        int(u.get("input_tokens") or 0)
        + int(u.get("cache_creation_input_tokens") or 0)
        + int(u.get("cache_read_input_tokens") or 0)
        for u in by_msg.values()
    )
    tokens_out = sum(int(u.get("output_tokens") or 0) for u in by_msg.values())
    return tokens_in, tokens_out


def cached_pr_number(root: str, branch: str) -> str:
    if not root or not branch:
        return ""
    cache_base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    cache_dir = cache_base / "claude-statusline"
    key = re.sub(r"[^A-Za-z0-9]+", "-", f"{root}#{branch}")
    value_file = cache_dir / f"{key}.pr"
    stamp_file = cache_dir / f"{key}.stamp"

    pr_num = ""
    if value_file.is_file():
        raw = value_file.read_text(errors="replace").strip()
        if raw.isdigit():
            pr_num = raw

    now = time.time()
    fresh = stamp_file.is_file() and (now - stamp_file.stat().st_mtime) < 300
    if not fresh:
        try:
            cache_dir.mkdir(parents=True, exist_ok=True)
            stamp_file.write_text("")
            subprocess.Popen(
                [
                    "bash",
                    "-c",
                    'num="$(gh pr list --head "$1" --state open --json number '
                    '--jq ".[0].number // empty" 2>/dev/null)" && '
                    'printf "%s" "$num" > "$2.tmp" && mv -f "$2.tmp" "$2"',
                    "_",
                    branch,
                    str(value_file),
                ],
                cwd=root,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            pass
    return pr_num


def main() -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        data = {}
    if not isinstance(data, dict):
        data = {}

    ws = data.get("workspace") if isinstance(data.get("workspace"), dict) else {}
    ws_repo = ws.get("repo") if isinstance(ws.get("repo"), dict) else {}
    model_obj = data.get("model") if isinstance(data.get("model"), dict) else {}
    effort_obj = data.get("effort") if isinstance(data.get("effort"), dict) else {}
    ctx = (
        data.get("context_window")
        if isinstance(data.get("context_window"), dict)
        else {}
    )
    limits = (
        data.get("rate_limits") if isinstance(data.get("rate_limits"), dict) else {}
    )
    five_hr = (
        limits.get("five_hour") if isinstance(limits.get("five_hour"), dict) else {}
    )

    repo = clean(ws_repo.get("name"))
    cwd = clean(ws.get("current_dir") or data.get("cwd")) or os.getcwd()
    model = clean(model_obj.get("display_name") or model_obj.get("id"))
    effort = clean(effort_obj.get("level"))
    fast = "fast" if data.get("fast_mode") else ""
    session_id = clean(data.get("session_id") or data.get("conversation_id"))
    title = clean(data.get("session_name")) or session_id[:8]
    transcript = clean(data.get("transcript_path"))
    used = int(ctx.get("total_input_tokens") or 0) + int(
        ctx.get("total_output_tokens") or 0
    )
    window = int(ctx.get("context_window_size") or 0)
    used_pct = five_hr.get("used_percentage")
    budget_left = (
        max(0, 100 - int(used_pct)) if isinstance(used_pct, (int, float)) else None
    )

    tokens_in, tokens_out = read_transcript_tokens(transcript)

    root = git_out(cwd, "rev-parse", "--show-toplevel")
    if not repo and root:
        common_dir = git_out(cwd, "rev-parse", "--git-common-dir")
        if common_dir:
            common_path = (Path(cwd) / common_dir).resolve()
            if common_path.name == ".git":
                repo = common_path.parent.name
        if not repo:
            repo = Path(root).name

    branch = ""
    changed_files = ""
    if root:
        branch = git_out(cwd, "branch", "--show-current") or git_out(
            cwd, "rev-parse", "--short", "HEAD"
        )
        status_lines = git_out(cwd, "status", "--porcelain")
        count = len(status_lines.splitlines()) if status_lines else 0
        if count > 0:
            changed_files = str(count)

    home = str(Path.home())
    if cwd == home:
        display_dir = "~"
    elif cwd.startswith(home + "/"):
        display_dir = "~" + cwd[len(home) :]
    else:
        display_dir = cwd

    pr_number = cached_pr_number(root, branch)

    model_group = " ".join(p for p in (model, effort, fast) if p) if model else ""

    budget = ""
    budget_color = GREEN
    if budget_left is not None:
        budget = f"5h {budget_left}% left"
        if budget_left < 10:
            budget_color = RED
        elif budget_left < 25:
            budget_color = YELLOW

    segments: list[str] = []

    def add(color: str, icon: str, value: str) -> None:
        if value:
            segments.append(f"{color}{icon} {value}{RESET}")

    add(CYAN, ICON_REPO, repo)
    add(GREEN, ICON_BRANCH, clamp(branch, 28))
    add(BLUE, ICON_DIR, display_dir)
    add(MAGENTA, ICON_PR, f"#{pr_number}" if pr_number else "")
    add(RED, ICON_DIFF, changed_files)
    add(CYAN, ICON_MODEL, model_group)
    add(MAGENTA, ICON_TITLE, clamp(title, 48))
    add(YELLOW, ICON_USED, label(used, "used"))
    add(BLUE, ICON_IN, label(tokens_in, "in"))
    add(BLUE, ICON_OUT, label(tokens_out, "out"))
    add(DIM, ICON_WINDOW, label(window, "window"))
    add(budget_color, ICON_CLOCK, budget)

    sys.stdout.write(f"{DIM} {BULLET} {RESET}".join(segments))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
