#!/usr/bin/env python3

"""Overlay this repo's agent config onto the copy the agent rewrites in $HOME.

Repo keys stay authoritative; keys the user or the tool added themselves are
preserved. The previous file is backed up before any change. Honors DRY_RUN.

The format is chosen by the source suffix: .json merges objects recursively
(Claude, Antigravity), .toml overlays tables and array-of-tables (Codex, Grok).

Usage:
  inject-config <source-config> <target-config>
"""

from __future__ import annotations

import json
import os
import sys
import tempfile
from datetime import datetime
from pathlib import Path

# --- JSON ---------------------------------------------------------------------


def load_json(text: str, path: Path) -> dict:
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError(f"expected a JSON object, got {type(data).__name__}: {path}")
    return data


def merge_json_sources(base: dict, extra: dict) -> dict:
    merged = dict(base)
    for key, ext_val in extra.items():
        cur_val = merged.get(key)
        if isinstance(cur_val, dict) and isinstance(ext_val, dict):
            merged[key] = merge_json_sources(cur_val, ext_val)
        elif isinstance(cur_val, list) and isinstance(ext_val, list):
            merged[key] = cur_val + [x for x in ext_val if x not in cur_val]
        else:
            merged[key] = ext_val
    return merged


def merge_json_dicts(current: dict, incoming: dict) -> dict:
    merged = dict(current)
    for key, inc_val in incoming.items():
        cur_val = merged.get(key)
        if isinstance(cur_val, dict) and isinstance(inc_val, dict):
            merged[key] = merge_json_dicts(cur_val, inc_val)
        else:
            merged[key] = inc_val
    return merged


def render_json(
    sources: list[tuple[Path, str]], target: str, target_path: Path
) -> str:
    try:
        current = load_json(target or "{}", target_path)
    except (ValueError, json.JSONDecodeError) as exc:
        raise ValueError(
            f"refusing to overwrite unparseable {target_path}: {exc}"
        ) from exc

    incoming: dict = {}
    for source_path, source_text in sources:
        try:
            parsed = load_json(source_text, source_path)
        except (ValueError, json.JSONDecodeError) as exc:
            raise ValueError(f"invalid source config {source_path}: {exc}") from exc
        incoming = merge_json_sources(incoming, parsed)

    return json.dumps(merge_json_dicts(current, incoming), indent=2) + "\n"


def equivalent_json(left: str, right: str) -> bool:
    # Agents rewrite settings.json with keys reordered, so a text compare
    # would churn (rewrite + backup) on every run even when nothing changed.
    try:
        return json.loads(left) == json.loads(right)
    except json.JSONDecodeError:
        return False


# --- TOML ---------------------------------------------------------------------


def key_name(line: str) -> str | None:
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or stripped.startswith("["):
        return None
    if "=" not in stripped:
        return None
    return stripped.split("=", 1)[0].strip()


def table_name(line: str) -> str | None:
    stripped = line.strip()
    if not stripped.startswith("["):
        return None
    return stripped.split("#", 1)[0].strip()


def is_array_table(header: str) -> bool:
    return header.startswith("[[") and header.endswith("]]")


def array_table_prefix(header: str) -> str:
    return header[2:-2].strip()


def unclosed_delimiters(line: str) -> int:
    """Net bracket delta outside strings/comments for multiline TOML values."""
    in_str: str | None = None
    escaped = False
    delta = 0
    for ch in line:
        if escaped:
            escaped = False
            continue
        if in_str:
            if ch == "\\":
                escaped = True
            elif ch == in_str:
                in_str = None
            continue
        if ch in ('"', "'"):
            in_str = ch
        elif ch == "#":
            break
        elif ch in ("[", "{"):
            delta += 1
        elif ch in ("]", "}"):
            delta -= 1
    return delta


def parse_entries(lines: list[str]) -> list[tuple[str, list[str]]]:
    """Group key = value assignments (including multiline arrays) by key name."""
    entries: list[tuple[str, list[str]]] = []
    current_key: str | None = None
    current_lines: list[str] = []
    depth = 0

    for line in lines:
        if depth > 0 and current_key is not None:
            current_lines.append(line)
            depth = max(0, depth + unclosed_delimiters(line))
            if depth == 0:
                entries.append((current_key, current_lines))
                current_key, current_lines = None, []
            continue

        key = key_name(line)
        if key is None:
            continue
        depth = max(0, unclosed_delimiters(line))
        if depth == 0:
            entries.append((key, [line]))
        else:
            current_key = key
            current_lines = [line]

    if current_key is not None and current_lines:
        entries.append((current_key, current_lines))
    return entries


def keys_in_lines(lines: list[str]) -> set[str]:
    return {key for key, _ in parse_entries(lines)}


def split_config(lines: list[str]) -> tuple[list[str], list[list[str]]]:
    root_lines: list[str] = []
    tables: list[list[str]] = []
    current: list[str] | None = None

    for line in lines:
        if table_name(line):
            if current is not None:
                tables.append(current)
            current = [line]
        elif current is None:
            root_lines.append(line)
        else:
            current.append(line)

    if current is not None:
        tables.append(current)

    return root_lines, tables


def strip_blank_edges(lines: list[str]) -> list[str]:
    start, end = 0, len(lines)
    while start < end and lines[start].strip() == "":
        start += 1
    while end > start and lines[end - 1].strip() == "":
        end -= 1
    return lines[start:end]


def filter_entries(lines: list[str], excluded_keys: set[str]) -> list[str]:
    kept: list[str] = []
    for key, entry_lines in parse_entries(lines):
        if key not in excluded_keys:
            kept.extend(entry_lines)
    return strip_blank_edges(kept)


def filter_target(
    lines: list[str],
    root_keys: set[str],
    source_table_keys: dict[str, set[str]],
    source_array_prefixes: set[str],
) -> tuple[list[str], dict[str, list[str]], list[list[str]]]:
    root_lines, tables = split_config(lines)
    preserved_bodies: dict[str, list[str]] = {}
    target_tables: list[list[str]] = []

    filtered_root = filter_entries(root_lines, root_keys)

    for section in tables:
        if not section:
            continue

        name = table_name(section[0])
        if name is None:
            continue

        if is_array_table(name):
            prefix = array_table_prefix(name)
            if any(
                prefix == p or prefix.startswith(f"{p}.")
                for p in source_array_prefixes
            ):
                continue
            target_tables.append(strip_blank_edges(section))
            continue

        if name not in source_table_keys:
            target_tables.append(strip_blank_edges(section))
            continue

        body = filter_entries(section[1:], source_table_keys[name])
        if body:
            preserved_bodies[name] = body

    return filtered_root, preserved_bodies, target_tables


def render_toml(
    sources: list[tuple[Path, str]], target: str, target_path: Path
) -> str:
    source = "\n".join(s for _, s in sources)
    del target_path

    source_root, source_tables = split_config(source.splitlines())
    source_table_keys: dict[str, set[str]] = {}
    source_array_prefixes: set[str] = set()

    for section in source_tables:
        name = table_name(section[0])
        if not name:
            continue
        if is_array_table(name):
            source_array_prefixes.add(array_table_prefix(name))
        else:
            source_table_keys[name] = keys_in_lines(section[1:])

    target_root, preserved_bodies, target_tables = filter_target(
        target.splitlines(),
        keys_in_lines(source_root),
        source_table_keys,
        source_array_prefixes,
    )

    chunks: list[list[str]] = []
    if source_root := strip_blank_edges(source_root):
        chunks.append(source_root)
    if target_root:
        chunks.append(target_root)

    for section in source_tables:
        if not (stripped := strip_blank_edges(section)):
            continue
        header = table_name(stripped[0]) or ""
        chunks.append(stripped + preserved_bodies.get(header, []))

    chunks.extend(table for table in target_tables if table)

    return "\n\n".join("\n".join(chunk) for chunk in chunks if chunk) + "\n"


def equivalent_text(left: str, right: str) -> bool:
    return left == right


# --- driver -------------------------------------------------------------------

FORMATS = {
    ".json": (render_json, equivalent_json),
    ".jsonc": (render_json, equivalent_json),
    ".toml": (render_toml, equivalent_text),
}


def atomic_write(path: Path, content: str, original: str | None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    if original is not None:
        stamp = os.environ.get("TIMESTAMP") or datetime.now().strftime("%Y%m%d-%H%M%S")
        backup = path.with_name(f"{path.name}.bak.{stamp}")
        backup.write_text(original)
        print(f"backed up existing config: {backup}")

    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as tmp:
        tmp.write(content)
        tmp_path = Path(tmp.name)

    os.replace(tmp_path, path)


def needs_detach(target: Path, source: Path) -> bool:
    """True when the target is a link to the repo rather than its own file."""
    if target.is_symlink():
        return True
    try:
        return target.exists() and os.path.samefile(target, source)
    except OSError:
        return False


def main() -> int:
    if len(sys.argv) < 3:
        print(
            f"usage: {Path(sys.argv[0]).name} <source-config>... <target-config>",
            file=sys.stderr,
        )
        return 2

    sources = [Path(arg) for arg in sys.argv[1:-1]]
    target = Path(sys.argv[-1])

    for source in sources:
        if source.suffix not in FORMATS:
            print(f"unsupported config format: {source}", file=sys.stderr)
            return 1
        if not source.exists():
            print(f"missing source config: {source}", file=sys.stderr)
            return 1

    render, equivalent = FORMATS[sources[-1].suffix]
    target_original = target.read_text() if target.exists() else None
    source_pairs = [(s, s.read_text()) for s in sources]

    try:
        rendered = render(source_pairs, target_original or "", target)
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        print("fix or remove the file, then re-run.", file=sys.stderr)
        return 1

    must_detach = any(needs_detach(target, s) for s in sources)

    if (
        target_original is not None
        and equivalent(rendered, target_original)
        and not must_detach
    ):
        print(f"already current: {target}")
        return 0

    if os.environ.get("DRY_RUN") == "true":
        if must_detach:
            action = "would detach + update"
        else:
            action = "would update" if target.exists() else "would create"
        print(f"{action}: {target}")
        return 0

    atomic_write(target, rendered, target_original)
    print(f"injected config: {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
