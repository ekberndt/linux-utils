{
  "agentMode": "auto",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "editor": "nvim",
  "model": "Gemini 4 Argon (High)",
  "notifications": true,
  "queuedMessages": "queue",
  "runningLightSpeed": "fast",
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "~/.agents/scripts/statusline-worktree"
  },
  "title": {
    "type": "command",
    "command": "python3 -c 'import json,sys; print(json.load(sys.stdin).get(\"conversation_title\") or \"Antigravity\")'"
  },
  "toolPermission": "always-proceed",
  "verbosity": "low"
}
